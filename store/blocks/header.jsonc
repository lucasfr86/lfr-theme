{
  "header": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header.full": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header-layout.desktop": {
    "title": "Header Layout Desktop", 
    "children": [
      "sticky-layout#desktop"
    ]
  },
  "sticky-layout#desktop": {
    "props": {
      "blockClass": "sticky-header"
    },
    "children": [
      "flex-layout.row#desktop",
      "flex-layout.row#desktop-items"
    ]
  },
  
  // Desktop Header
  
  "flex-layout.row#desktop": {
    "title": "Top Header Row", 
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "fullWidth": true,
      "blockClass": "main-header-desktop"
    },
    "children": [
      "flex-layout.col#logo-desktop",
      "flex-layout.col#search-desktop",
      "flex-layout.col#login-desktop",
      "flex-layout.col#login-minicart-desktop"
    ]
  },
  "flex-layout.col#logo-desktop": {
    "props": {
      "width": "13%",
      "blockClass": "logo",
      "horizontalAlign": "center",
      "verticalAlign": "middle"
    },
    "children": ["logo"]
  },
  "logo": {
    "props": {
      "title": "Logo",
      "href": "/",
      "url": "https://storecomponents.vtexassets.com/arquivos/store-theme-logo.png",
      "width": "120"
    }
  },
  "flex-layout.col#search-desktop":{
    "children": ["search-bar"],
      "props": {
        "blockClass": "search",
        "width": "72%"
      }
  },
  "flex-layout.col#login-desktop":{
    "children": ["login"],
    "props": {
      "width": "10%",
      "blockClass": "account",
      "horizontalAlign": "center",
      "verticalAlign": "middle"
    }
  },
  "flex-layout.col#login-minicart-desktop":{
    "children": ["minicart.v2"],
    "props": { 
      "width": "5%",
      "blockClass": "minicart",
      "horizontalAlign": "center",
      "verticalAlign": "middle"
    }
  },

  "login":{
    "props": {
      "iconLabel": "Iniciar sesión",
      "showIconProfile": true,
      "logInButtonBehavior": "link"
    }
  },

  // Row items

  "flex-layout.row#desktop-items": {
    "title": "Menu Header Row",
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "fullWidth": true,
      "blockClass": "main-header-desktop-items",
      "preventHorizontalStretch": true
    },
    "children": [
      "vtex.menu@2.x:menu#main-navigation-1",
      "vtex.menu@2.x:menu#main-navigation-2",
      "vtex.menu@2.x:menu#main-navigation-3",
      "vtex.menu@2.x:menu#main-navigation-4"
    ]
  },

  // =========================================================
  // DEPARTAMENTO: CELULARES
  // =========================================================

  "vtex.menu@2.x:menu#main-navigation-1": {
    "title": "Menu Celulares",
    "children": [
      "menu-item#department-cellphones"
    ]
  },

  "menu-item#department-cellphones": {
    "title": "Departamento Celulares",
    "props": {
      "type": "custom",
      "highlight": false,
      "itemProps": {
        "type": "internal",
        "href": "/celulares",
        "noFollow": false,
        "tagTitle": "Celulares",
        "text": "Celulares"
      }
    },
    "blocks": [
      "vtex.menu@2.x:submenu#cellphones"
    ]
  },

  "vtex.menu@2.x:submenu#cellphones": {
